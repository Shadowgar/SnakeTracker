SNAKETRACKER_ENVIRONMENT=development
SNAKETRACKER_DATABASE_PATH=data/snaketracker.sqlite3
SNAKETRACKER_ATTACHMENT_STORAGE_PATH=data/attachments
SNAKETRACKER_BACKUP_STORAGE_PATH=backups
SNAKETRACKER_HTTP_PORT=8081
SNAKETRACKER_EXTERNAL_ORIGIN=http://localhost:8081
SNAKETRACKER_BACKUP_ENCRYPTION_KEY_ID=local-development-v1
SNAKETRACKER_LOG_LEVEL=INFO
# Production only:
# SNAKETRACKER_EXTERNAL_ORIGIN=https://snaketracker.example
# SNAKETRACKER_RUNTIME_SECRET_FILE=/run/secrets/snaketracker_runtime_secret
# SNAKETRACKER_BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/snaketracker_backup_encryption_key
